APP_NAME=EnterpriseMind
APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/enterprise_agent.db
JWT_SECRET=change-me-in-production-use-at-least-32-bytes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173
AUTO_SEED=true
MAX_UPLOAD_MB=20
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
RUNTIME_CONFIG_PATH=backend/data/llm_config.json
RAG_CANDIDATE_LIMIT=50
